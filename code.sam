function int double_val(int x) {
    return x + x;
}

function int square(int x) {
    return x * x;
}

int n = 8;

for (int i = 1; i < n; i++) {
    print(square(i));
}

if(n > 5) {
    print(n);
    print(n);
    print(n);
    print(n);
    print(n);
    print(n);
}

int j = 1;
while (j < n) {
    print(double_val(j));
    j++;
}
