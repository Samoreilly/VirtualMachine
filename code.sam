function int fibonacci(int n) {
    if(n == 1) {
        return n;
    }
    if(n == 0) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

print(fibonacci(0));
print(fibonacci(1));
print(fibonacci(5));
print(fibonacci(10));
print(fibonacci(12));

int n = 8;
for (int i = 1; i < n; i++) {
    print(i);
}

int j = 1;
while (j < 4) {
    print(j);
    j++;
}
